@charset "utf-8";

:root { --lobby__max-width: 100%; }

*, ::after, ::before { box-sizing: inherit; padding: 0px; margin: 0px; }

h1, h2, h3, h4, h5, h6 { font-weight: 400; }

ul { list-style: none; }

img, video { height: auto; max-width: 100%; }

iframe { border: 0px; }

table { border-collapse: collapse; border-spacing: 0px; }

html { width: 100%; height: 100%; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html[data-device="mobile"] { font-size: calc(13.3333vw); }

html[data-ui-contain="1"] { background: var(--skin__border); font-size: calc(var(--lobby__max-width) / (750 / 100)); }

html[data-ui-contain="0"] { --lobby__max-width: 100%; }
