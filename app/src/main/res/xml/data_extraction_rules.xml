<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+. Mesma regra do backup_rules.xml: lista branca de
         preferências, sem <exclude> redundante (reprovado pelo lint). -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
